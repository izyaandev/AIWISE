generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  passwordHash       String
  role               String              @default("STUDENT") // STUDENT or ADMIN
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  courseProgresses   CourseProgress[]
  mediaCompletions   MediaCompletion[]
  assessmentAttempts AssessmentAttempt[]
  certificates       Certificate[]
  surveyResponses    SurveyResponse[]
}



model Course {
  id          String           @id @default(cuid())
  title       String
  description String
  syllabus    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  modules     Module[]
  progresses  CourseProgress[]
  certificates Certificate[]
  survey       Survey?
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id])
  lessons     Lesson[]
}

model Lesson {
  id               String            @id @default(cuid())
  moduleId         String
  title            String
  content          String? // Markdown or HTML content
  mediaType        String? // VIDEO or AUDIO
  mediaUrl         String?
  minimumDwellTime Int? // In seconds (e.g. 30s)
  order            Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  module           Module            @relation(fields: [moduleId], references: [id])
  mediaCompletions MediaCompletion[]
  assessments      Assessment[]
}



model MediaCompletion {
  id                 String   @id @default(cuid())
  userId             String
  lessonId           String
  percentageWatched  Float    @default(0)
  isCompleted        Boolean  @default(false)
  dwellTimeSeconds   Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id])
  lesson             Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

model CourseProgress {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  lessonsCompleted Int      @default(0)
  overallPercentage Float    @default(0)
  isCompleted     Boolean  @default(false)
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
  course          Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model Assessment {
  id        String              @id @default(cuid())
  lessonId  String
  title     String
  questions Question[]
  attempts  AssessmentAttempt[]
  lesson    Lesson              @relation(fields: [lessonId], references: [id])
}

model Question {
  id            String     @id @default(cuid())
  assessmentId  String
  text          String
  options       String // JSON array
  correctOption String
  assessment    Assessment @relation(fields: [assessmentId], references: [id])
}

model AssessmentAttempt {
  id           String     @id @default(cuid())
  userId       String
  assessmentId String
  score        Float
  passed       Boolean
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id])
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
}

model Certificate {
  id               String   @id @default(cuid())
  userId           String
  courseId         String
  verificationToken String   @unique @default(uuid())
  issuedAt         DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])
  course           Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model Survey {
  id        String           @id @default(cuid())
  courseId  String           @unique
  course    Course           @relation(fields: [courseId], references: [id])
  questions SurveyQuestion[]
  responses SurveyResponse[]
}

model SurveyQuestion {
  id        String   @id @default(cuid())
  surveyId  String
  survey    Survey   @relation(fields: [surveyId], references: [id])
  text      String
  order     Int
  type      String   @default("TEXT") // TEXT, RATING, etc.
}

model SurveyResponse {
  id        String   @id @default(cuid())
  surveyId  String
  userId    String
  answers   String   // JSON containing questionId -> answer mapping
  createdAt DateTime @default(now())
  survey    Survey   @relation(fields: [surveyId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, surveyId])
}
